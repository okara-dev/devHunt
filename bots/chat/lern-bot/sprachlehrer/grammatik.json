{
    "Spanisch": {
        "A1-A2": [
            {
                "thema": "Präsens (Presente)",
                "erklaerung": "Wird für Handlungen in der Gegenwart verwendet. Es gibt drei Verbklassen: -ar, -er, -ir.",
                "endungen": {
                    "hablar (-ar)": {
                        "yo": "-o",
                        "tú": "-as",
                        "él/ella/usted": "-a",
                        "nosotros": "-amos",
                        "vosotros": "-áis",
                        "ellos/ellas/ustedes": "-an"
                    },
                    "comer (-er)": {
                        "yo": "-o",
                        "tú": "-es",
                        "él/ella/usted": "-e",
                        "nosotros": "-emos",
                        "vosotros": "-éis",
                        "ellos/ellas/ustedes": "-en"
                    },
                    "vivir (-ir)": {
                        "yo": "-o",
                        "tú": "-es",
                        "él/ella/usted": "-e",
                        "nosotros": "-imos",
                        "vosotros": "-ís",
                        "ellos/ellas/ustedes": "-en"
                    }
                },
                "beispiel": "Yo hablo español. (Ich spreche Spanisch.)",
                "typische_fehler": "Endungen nicht verwechseln: -ar → -o, -as, -a, -amos, -áis, -an"
            },
            {
                "thema": "Präteritum (Pretérito Indefinido)",
