                    "hablar (-ar)": {
                        "yo": "-é",
                        "tú": "-aste",
                        "él/ella/usted": "-ó",
                        "nosotros": "-amos",
                        "vosotros": "-asteis",
                        "ellos/ellas/ustedes": "-aron"
