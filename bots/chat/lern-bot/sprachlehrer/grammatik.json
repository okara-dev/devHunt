                        "vosotros": "-abais",
                        "ellos/ellas/ustedes": "-aban"
                    },
                    "comer (-er)": {
                        "yo": "-ía",
                        "tú": "-ías",
                        "él/ella/usted": "-ía",
                        "nosotros": "-íamos",
                        "vosotros": "-íais",
                        "ellos/ellas/ustedes": "-ían"
                    },
                    "vivir (-ir)": {
                        "yo": "-ía",
                        "tú": "-ías",
                        "él/ella/usted": "-ía",
                        "nosotros": "-íamos",
                        "vosotros": "-íais",
                        "ellos/ellas/ustedes": "-ían"
