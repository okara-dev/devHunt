      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Der komplette Satz, z. B. 'lösche den Termin am 16.10 Vorstellungsgespräch'"
          }
        },
        "required": ["text"]
      }
    },
    {
      "name": "clear_calendar",
