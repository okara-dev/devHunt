        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Der komplette Satz des Users, z. B. 'am 16.10 habe ich ein Vorstellungsgespräch um 14 Uhr'"
          }
        },
        "required": ["text"]
      }
    },
    {
      "name": "delete_calendar_event",
